# Copy to .env and adjust. All values have safe, conservative defaults.

# --- Bankroll ---
POLYBET_BANKROLL=1000

# --- Edge gate (must clear spread + slippage + gas to be worth trading) ---
POLYBET_MIN_EDGE=0.03

# --- Cost model ---
POLYBET_TAKER_FEE=0.0
POLYBET_SLIPPAGE=0.005
POLYBET_GAS_USD=0.02

# --- Sizing (fraction of full Kelly; 0.25 = quarter Kelly) ---
POLYBET_KELLY_FRACTION=0.25

# --- Risk caps ---
POLYBET_MAX_POSITION_FRACTION=0.05
POLYBET_MAX_TOTAL_EXPOSURE=0.50
POLYBET_MAX_OPEN_POSITIONS=25
POLYBET_MAX_BOOK_PARTICIPATION=0.25
POLYBET_MAX_DRAWDOWN=0.20

# --- Valuation (0 = pure market consensus/no edge, 1 = fully trust our model) ---
POLYBET_MODEL_CONFIDENCE=0.5

# --- Live trading guard (keep false until the go-live checklist is complete) ---
POLYBET_ENABLE_LIVE=false

# --- Live secrets (only needed when enabling live trading) ---
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
